# --- shared (safe-stage red flags) ---
.DS_Store
.env
.env.*
!.env.example
*.log
.idea/
.vscode/
*.sqlite
*.db
*.zip
*.tar
*.tar.gz

# --- automation ---
# Ignore generated data, EXCEPT the tracker CSV: the scheduled collector commits
# it back so dedup state survives between runs (it holds only public job leads).
data/*
!data/leads.csv
secrets/
*.secret
credentials.json
token.json
state/
*.state
__pycache__/
.venv/
venv/
